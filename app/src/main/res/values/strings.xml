    <!-- In-App Privacy Policy -->
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_badge_no_data">100% Private · No Data Collected</string>
    <string name="privacy_core_commitment">Core Commitment</string>
    <string name="privacy_core_commitment_desc">We collect no personal data. Your name and favorite driver preferences are stored locally on your device via DataStore. No data is sent to any server. News is fetched from public RSS feeds.</string>
    <string name="privacy_sec_no_data_title">No Personal Data Collected</string>
    <string name="privacy_sec_no_data_p1">Taras is an open-source, non-commercial F1 companion app. We believe in complete transparency and maximum privacy:</string>
    <string name="privacy_sec_no_data_item1">No names, emails, phone numbers, or account logins</string>
    <string name="privacy_sec_no_data_item2">No precise or coarse location tracking</string>
    <string name="privacy_sec_no_data_item3">No advertising IDs (GAID), device IDs, or IP logging</string>
    <string name="privacy_sec_no_data_item4">No commercial advertising SDKs, marketing trackers, or analytics</string>
    <string name="privacy_sec_storage_title">Strictly On-Device Storage</string>
    <string name="privacy_sec_storage_desc">Your nickname, favorite driver, favorite team, and theme preferences are stored exclusively on your device using Android Jetpack DataStore and Room. No data is ever transmitted to an external server. You can wipe all data anytime by clearing app storage or uninstalling.</string>
    <string name="privacy_sec_network_title">Public Feeds &amp; Encryption</string>
    <string name="privacy_sec_network_desc">Race schedules and standings are retrieved from public static files on GitHub. News articles are parsed directly on your device from public RSS feeds. All network connections use secure HTTPS.</string>
    <string name="privacy_sec_notifications_title">Device Permissions</string>
    <string name="privacy_sec_notifications_desc">Notification permission (POST_NOTIFICATIONS) is used solely to deliver local race countdown reminders scheduled on your phone by Android WorkManager. No remote push tokens are collected.</string>
    <string name="privacy_sec_opensource_title">Open Source Transparency</string>
    <string name="privacy_sec_opensource_desc">Taras is completely open-source under the Apache 2.0 license. Anyone can inspect the code on GitHub to verify our privacy commitments.</string>
