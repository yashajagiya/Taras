    <!-- In-App Privacy Policy -->
    <string name="privacy_policy_title">Politique de confidentialité</string>
    <string name="privacy_badge_no_data">100% Privé · Aucune donnée collectée</string>
    <string name="privacy_core_commitment">Engagement Fondamental</string>
    <string name="privacy_core_commitment_desc">Nous ne collectons aucune donnée personnelle. Votre nom et vos préférences de pilote sont stockés localement sur votre appareil via DataStore. Aucune donnée n\'est envoyée à aucun serveur. Les actualités proviennent de flux RSS publics.</string>
    <string name="privacy_sec_no_data_title">Aucune donnée personnelle collectée</string>
    <string name="privacy_sec_no_data_p1">Taras est une application F1 open source et non commerciale. Nous croyons en la transparence totale et la confidentialité absolue :</string>
    <string name="privacy_sec_no_data_item1">Pas de nom, email, téléphone ou compte utilisateur</string>
    <string name="privacy_sec_no_data_item2">Aucun suivi de localisation géolocalisée</string>
    <string name="privacy_sec_no_data_item3">Aucun identifiant publicitaire (GAID) ni journalisation IP</string>
    <string name="privacy_sec_no_data_item4">Aucun SDK publicitaire ou outil d\'analyse commercial</string>
    <string name="privacy_sec_storage_title">Stockage strictement local</string>
    <string name="privacy_sec_storage_desc">Vos préférences sont conservées uniquement sur votre appareil via DataStore et Room. Vous pouvez tout supprimer en vidant les données de l\'application ou en la désinstallant.</string>
    <string name="privacy_sec_network_title">Flux publics et sécurité</string>
    <string name="privacy_sec_network_desc">Les résultats proviennent de fichiers statiques publics sur GitHub. Les actualités sont lues depuis des flux RSS publics. Toutes les connexions sont en HTTPS sécurisé.</string>
    <string name="privacy_sec_notifications_title">Autorisations de l\'appareil</string>
    <string name="privacy_sec_notifications_desc">L\'autorisation de notification sert uniquement aux rappels locaux planifiés par WorkManager. Aucun jeton distant n\'est collecté.</string>
    <string name="privacy_sec_opensource_title">Transparence Open Source</string>
    <string name="privacy_sec_opensource_desc">Taras est totalement open source. Vous pouvez inspecter le code sur GitHub à tout moment.</string>
