    <!-- In-App Privacy Policy -->
    <string name="privacy_policy_title">Política de Privacidade</string>
    <string name="privacy_badge_no_data">100% Privado · Nenhum dado coletado</string>
    <string name="privacy_core_commitment">Compromisso Central</string>
    <string name="privacy_core_commitment_desc">Não coletamos dados pessoais. Seu nome e preferências de piloto favorito são armazenados localmente no seu dispositivo via DataStore. Nenhum dado é enviado a nenhum servidor. As notícias são obtidas de feeds RSS públicos.</string>
    <string name="privacy_sec_no_data_title">Nenhum dado pessoal coletado</string>
    <string name="privacy_sec_no_data_p1">O Taras é um aplicativo F1 de código aberto e sem fins lucrativos. Acreditamos na transparência total e privacidade máxima:</string>
    <string name="privacy_sec_no_data_item1">Sem nomes, e-mails, telefones ou contas de usuário</string>
    <string name="privacy_sec_no_data_item2">Sem rastreamento de localização geográfica</string>
    <string name="privacy_sec_no_data_item3">Sem IDs de publicidade (GAID), IDs de dispositivo ou registro de IP</string>
    <string name="privacy_sec_no_data_item4">Sem SDKs de anúncios comerciais, rastreadores ou análises</string>
    <string name="privacy_sec_storage_title">Armazenamento estritamente no dispositivo</string>
    <string name="privacy_sec_storage_desc">Seu apelido, piloto favorito, equipe favorita e temas são salvos exclusivamente no seu telefone usando DataStore e Room. Nenhum dado é transmitido para fora. Você pode apagar tudo limpando os dados do app ou desinstalando.</string>
    <string name="privacy_sec_network_title">Feeds públicos e criptografia</string>
    <string name="privacy_sec_network_desc">Horários e classificações são obtidos de arquivos públicos no GitHub. As notícias são lidas diretamente de feeds RSS públicos. Todas as conexões utilizam HTTPS seguro.</string>
    <string name="privacy_sec_notifications_title">Permissões do dispositivo</string>
    <string name="privacy_sec_notifications_desc">A permissão de notificação é usada somente para lembretes de corrida locais agendados pelo WorkManager. Nenhum token remoto é coletado.</string>
    <string name="privacy_sec_opensource_title">Transparência de código aberto</string>
    <string name="privacy_sec_opensource_desc">O Taras é totalmente de código aberto no GitHub para que qualquer um possa verificar nossos compromissos de privacidade.</string>
