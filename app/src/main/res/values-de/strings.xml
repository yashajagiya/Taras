    <!-- In-App Privacy Policy -->
    <string name="privacy_policy_title">Datenschutzerklärung</string>
    <string name="privacy_badge_no_data">100% Privat · Keine Datenerfassung</string>
    <string name="privacy_core_commitment">Kernversprechen</string>
    <string name="privacy_core_commitment_desc">Wir erfassen keine personenbezogenen Daten. Dein Name und deine Lieblingstreiberpräferenzen werden über DataStore lokal auf deinem Gerät gespeichert. Es werden keine Daten an einen Server gesendet. Nachrichten werden aus öffentlichen RSS-Feeds abgerufen.</string>
    <string name="privacy_sec_no_data_title">Keine personenbezogenen Daten erfasst</string>
    <string name="privacy_sec_no_data_p1">Taras ist eine quelloffene, nicht-kommerzielle F1-App. Wir glauben an vollständige Transparenz und Datenschutz:</string>
    <string name="privacy_sec_no_data_item1">Keine Namen, E-Mails, Telefonnummern oder Konten</string>
    <string name="privacy_sec_no_data_item2">Keine Standortverfolgung</string>
    <string name="privacy_sec_no_data_item3">Keine Werbe-IDs (GAID), Geräte-IDs oder IP-Protokollierung</string>
    <string name="privacy_sec_no_data_item4">Keine kommerziellen Werbe-SDKs, Tracker oder Analysen</string>
    <string name="privacy_sec_storage_title">Ausschließlich lokale Speicherung</string>
    <string name="privacy_sec_storage_desc">Dein Name, Lieblingsfahrer, Lieblingsteam und Theme-Einstellungen werden ausschließlich auf deinem Telefon gespeichert (Jetpack DataStore &amp; Room). Lösche die App-Daten oder deinstalliere die App, um alles zu entfernen.</string>
    <string name="privacy_sec_network_title">Öffentliche Feeds &amp; Verschlüsselung</string>
    <string name="privacy_sec_network_desc">Rennpläne und Tabellen werden von statischen GitHub-Dateien geladen. Nachrichten stammen aus öffentlichen RSS-Feeds. Alle Verbindungen nutzen HTTPS.</string>
    <string name="privacy_sec_notifications_title">Berechtigungen</string>
    <string name="privacy_sec_notifications_desc">Benachrichtigungen werden ausschließlich für lokale Rennerinnerungen über den Android WorkManager verwendet. Keine Remote-Tokens.</string>
    <string name="privacy_sec_opensource_title">Open-Source-Transparenz</string>
    <string name="privacy_sec_opensource_desc">Taras ist vollständig quelloffen. Der Code kann auf GitHub frei eingesehen und überprüft werden.</string>
    <string name="privacy_btn_view_online">Online-Richtlinie ansehen</string>
