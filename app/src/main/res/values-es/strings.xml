    <!-- In-App Privacy Policy -->
    <string name="privacy_policy_title">Política de Privacidad</string>
    <string name="privacy_badge_no_data">100% Privado · Sin recopilación de datos</string>
    <string name="privacy_core_commitment">Compromiso Fundamental</string>
    <string name="privacy_core_commitment_desc">No recopilamos datos personales. Tu nombre y preferencias de piloto favorito se almacenan localmente en tu dispositivo mediante DataStore. No se envía ningún dato a ningún servidor. Las noticias se obtienen de fuentes RSS públicas.</string>
    <string name="privacy_sec_no_data_title">Sin recopilación de datos personales</string>
    <string name="privacy_sec_no_data_p1">Taras es una aplicación de F1 de código abierto y no comercial. Creemos en la total transparencia y la máxima privacidad:</string>
    <string name="privacy_sec_no_data_item1">Sin nombres, correos electrónicos, teléfonos ni cuentas</string>
    <string name="privacy_sec_no_data_item2">Sin seguimiento de ubicación geográfica</string>
    <string name="privacy_sec_no_data_item3">Sin identificadores de publicidad (GAID), ID de dispositivo ni registro de IP</string>
    <string name="privacy_sec_no_data_item4">Sin SDK de publicidad comercial, rastreadores ni análisis</string>
    <string name="privacy_sec_storage_title">Almacenamiento estrictamente en el dispositivo</string>
    <string name="privacy_sec_storage_desc">Tu apodo, piloto favorito, equipo favorito y temas se almacenan exclusivamente en tu teléfono usando Android Jetpack DataStore y Room. Ningún dato se transmite a un servidor externo. Puedes borrar todos los datos limpiando el almacenamiento o desinstalando.</string>
    <string name="privacy_sec_network_title">Fuentes públicas y seguridad</string>
    <string name="privacy_sec_network_desc">Los calendarios y clasificaciones se obtienen de archivos estáticos públicos en GitHub. Las noticias se leen directamente de fuentes RSS públicas. Todas las conexiones usan HTTPS seguro.</string>
    <string name="privacy_sec_notifications_title">Permisos del dispositivo</string>
    <string name="privacy_sec_notifications_desc">El permiso de notificaciones se usa únicamente para recordatorios locales programados en tu teléfono por Android WorkManager. No se recopilan tokens de inserción remota.</string>
    <string name="privacy_sec_opensource_title">Transparencia de código abierto</string>
    <string name="privacy_sec_opensource_desc">Taras es completamente de código abierto. Cualquiera puede inspeccionar el código en GitHub para verificar nuestros compromisos de privacidad.</string>
    <string name="privacy_btn_view_online">Ver política en línea</string>
