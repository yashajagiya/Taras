    <!-- In-App Privacy Policy (Indian DPDPA 2023 & IT Act Compliant) -->
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_badge_no_data">100% Private · No Cloud Data</string>
    <string name="privacy_badge_dpdpa">DPDPA 2023 Compliant · India</string>
    <string name="privacy_core_commitment">Core Commitment</string>
    <string name="privacy_core_commitment_desc">We collect no personal data on servers. Your nickname and preferences are stored exclusively on your device via Android Jetpack DataStore and Room. No telemetry, no ad tracking, and no cloud profile. Public news is fetched from public RSS feeds over HTTPS.</string>
    <string name="privacy_sec_no_data_title">No Personal Data Collected</string>
    <string name="privacy_sec_no_data_p1">Taras is an open-source, non-commercial F1 companion app. We believe in complete transparency and maximum privacy:</string>
    <string name="privacy_sec_no_data_item1">No names, emails, phone numbers, contacts, or accounts</string>
    <string name="privacy_sec_no_data_item2">No precise or coarse GPS location tracking</string>
    <string name="privacy_sec_no_data_item3">No advertising IDs (GAID), device hardware IDs, or IP logs</string>
    <string name="privacy_sec_no_data_item4">No commercial advertising SDKs, marketing trackers, or telemetry</string>
    <string name="privacy_sec_dpdpa_title">Digital Personal Data Protection Act, 2023 (India)</string>
    <string name="privacy_sec_dpdpa_desc">In compliance with the Digital Personal Data Protection Act, 2023 (DPDPA 2023) of India, Yash Ajagiya is the Data Fiduciary. Taras adheres strictly to purpose limitation and data minimization under Section 6. All preference processing is strictly on-device.</string>
    <string name="privacy_sec_principal_rights_title">Data Principal Rights (Sections 11–14 DPDPA)</string>
    <string name="privacy_right_access">Right to Access (Sec 11): View all your preferences directly in the app settings.</string>
    <string name="privacy_right_correction">Right to Correction (Sec 12): Change your nickname and favorites at any time.</string>
    <string name="privacy_right_erasure">Right to Erasure (Sec 12): Permanently delete all data by clearing app storage in Android Settings or uninstalling.</string>
    <string name="privacy_right_grievance">Right to Grievance Redressal (Sec 13): Contact the designated Grievance Officer for questions or resolution.</string>
    <string name="privacy_sec_storage_title">Strictly On-Device Storage</string>
    <string name="privacy_sec_storage_desc">Your nickname, favorite driver, favorite team, TCG card binder, and theme preferences are stored exclusively on your device using Android Jetpack DataStore and Room SQLite. No data is ever transmitted to an external server.</string>
    <string name="privacy_sec_network_title">Public Feeds &amp; Encryption</string>
    <string name="privacy_sec_network_desc">Race schedules and standings are retrieved from public static files on GitHub. News articles are parsed directly on your device from public RSS feeds. All network connections use secure HTTPS.</string>
    <string name="privacy_sec_notifications_title">Device Permissions</string>
    <string name="privacy_sec_notifications_desc">Notification permission (POST_NOTIFICATIONS) is used solely to deliver local race countdown reminders scheduled on your phone by Android WorkManager. No remote push tokens are collected.</string>
    <string name="privacy_sec_children_title">Children\'s Privacy (Section 9 DPDPA 2023)</string>
    <string name="privacy_sec_children_desc">Taras does not process identifiable personal data of children, nor does it conduct behavioral monitoring, profiling, or targeted advertising. The application is completely safe for motorsport enthusiasts of all ages.</string>
    <string name="privacy_sec_grievance_title">Grievance Officer (IT Rules 2021 &amp; DPDPA 2023)</string>
    <string name="privacy_sec_grievance_desc">In accordance with Rule 3(2) of the Information Technology (Intermediary Guidelines and Digital Media Ethics Code) Rules, 2021 and Section 13 of DPDPA 2023, queries or grievances are acknowledged within 48 hours and resolved within 15–30 days.</string>
    <string name="grievance_officer_name">Grievance Officer: Yash Ajagiya</string>
    <string name="grievance_officer_email">Email: yashajagiya@gmail.com</string>
    <string name="grievance_officer_location">Jurisdiction: Gujarat, India</string>
    <string name="privacy_sec_opensource_title">Open Source Transparency</string>
    <string name="privacy_sec_opensource_desc">Taras is completely open-source under the Apache 2.0 license. Anyone can inspect the code on GitHub to verify our privacy commitments.</string>
    <string name="privacy_btn_view_online">View Online</string>
    <string name="privacy_btn_got_it">Got It</string>

    <!-- In-App Terms of Service (Indian Law Compliant) -->
    <string name="terms_title">Terms of Service</string>
    <string name="terms_badge_it_act">Governed by Laws of India</string>
    <string name="terms_sec_agreement_title">1. Acceptance of Terms</string>
    <string name="terms_sec_agreement_desc">By downloading, installing, or using Taras, you enter into a legally binding agreement governed by the Indian Contract Act, 1872 and the Information Technology Act, 2000. If you do not agree to these terms, please discontinue use and uninstall the app.</string>
    <string name="terms_sec_license_title">2. Non-Commercial &amp; Open Source License</string>
    <string name="terms_sec_license_desc">Taras is a free, non-commercial Formula 1 companion application distributed under the Apache License, Version 2.0. The complete source code is transparently available on GitHub.</string>
    <string name="terms_sec_disclaimer_title">3. Unofficial Companion &amp; Trademark Fair Use</string>
    <string name="terms_sec_disclaimer_desc">Taras is an independent enthusiast application. It is NOT affiliated with, sponsored, or endorsed by Formula One Licensing B.V., Formula One Management (FOM), the FIA, or any Formula 1 constructor or driver. All trademarks, logos, and names (including \"Formula 1\", \"F1\", and constructor brands) are property of their respective owners and used solely for identification and nominative fair use under the Indian Trade Marks Act, 1999.</string>
    <string name="terms_sec_intermediary_title">4. Intermediary Status &amp; RSS Feeds (IT Rules 2021)</string>
    <string name="terms_sec_intermediary_desc">Under Section 2(1)(w) of the Information Technology Act, 2000, Taras operates strictly as an intermediary/aggregator for publicly available RSS feeds. All news headlines and article rights belong to their respective publishers. Taras exercises no editorial control over third-party content.</string>
    <string name="terms_sec_tcg_title">5. F1 GridTCG &amp; Virtual Digital Cards</string>
    <string name="terms_sec_tcg_desc">Cards in the F1 GridTCG module are strictly virtual, free-to-play collectibles stored locally on your device. They have NO real-money value, cannot be redeemed or traded for real currency, and do NOT constitute gambling, betting, or prize competitions under the Public Gambling Act, 1867 or State Gaming Acts.</string>
    <string name="terms_sec_conduct_title">6. Prohibited Activities</string>
    <string name="terms_sec_conduct_desc">You agree not to disrupt the app\'s data endpoints, launch automated scraping attacks, or exploit the app in violation of Section 66 of the Information Technology Act, 2000.</string>
    <string name="terms_sec_warranty_title">7. Disclaimer of Warranties &amp; Liability</string>
    <string name="terms_sec_warranty_desc">The application is provided \"AS IS\" and \"AS AVAILABLE\" without warranties of any kind. To the maximum extent permitted under Indian law, the developer shall not be liable for any indirect, incidental, or consequential damages.</string>
    <string name="terms_sec_jurisdiction_title">8. Governing Law &amp; Jurisdiction</string>
    <string name="terms_sec_jurisdiction_desc">These terms are governed by and construed in accordance with the laws of the Republic of India. The courts of Gujarat, India shall have exclusive jurisdiction over any disputes arising under or in connection with these terms.</string>

    <!-- In-App About Us -->
    <string name="about_title">About Taras</string>
    <string name="about_tagline">A high-performance, tracker-free Formula 1 companion</string>
    <string name="about_sec_story_title">The Meaning of Taras (तरस्)</string>
    <string name="about_sec_story_desc">\"Taras\" (तरस्) is a Sanskrit word meaning \"speed,\" \"velocity,\" \"dynamic energy,\" and \"strength.\" It embodies the essence of Formula 1 motorsport—swift, powerful, and driven by passion.</string>
    <string name="about_sec_developer_title">Developer &amp; Philosophy</string>
    <string name="about_sec_developer_desc">Created with passion by Yash Ajagiya, an independent Android engineer and Formula 1 fan based in India. Built to provide fans with a blazing-fast, ad-free, respectful experience without invasive tracking or subscriptions.</string>
    <string name="about_sec_pillars_title">Core Design Pillars</string>
    <string name="about_pillar1_title">100% Private · Zero Trackers</string>
    <string name="about_pillar1_desc">No accounts, no user analytics SDKs, and no ads. Data stays strictly on your device.</string>
    <string name="about_pillar2_title">Built for Indian &amp; Global Compliance</string>
    <string name="about_pillar2_desc">Compliant with India\'s Digital Personal Data Protection Act (DPDPA 2023) and Information Technology Act 2000.</string>
    <string name="about_pillar3_title">Modern Android &amp; Open Source</string>
    <string name="about_pillar3_desc">Built with Jetpack Compose, Material 3, Room, and Navigation 3 under the Apache 2.0 license.</string>
    <string name="about_sec_tech_title">Engineering &amp; Tech Stack</string>
    <string name="about_sec_tech_desc">Jetpack Compose · Material 3 · Room SQLite · DataStore · Ksoup XML · Glance Widgets · WorkManager</string>
    <string name="about_sec_compliance_title">Indian Legal Disclosures</string>
    <string name="about_sec_compliance_desc">Taras complies with the Digital Personal Data Protection Act, 2023, the Information Technology Act, 2000, and the Trade Marks Act, 1999 (Nominative Fair Use). For inquiries or grievances, contact our designated Grievance Officer.</string>
    <string name="about_btn_contact_grievance">Contact Grievance Officer</string>
    <string name="about_btn_view_github">View on GitHub</string>
