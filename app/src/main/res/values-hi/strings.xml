    <!-- In-App Privacy Policy (Indian DPDPA 2023 & IT Act Compliant) -->
    <string name="privacy_policy_title">गोपनीयता नीति</string>
    <string name="privacy_badge_no_data">100% निजी · क्लाउड डेटा नहीं</string>
    <string name="privacy_badge_dpdpa">DPDPA 2023 अनुपालक · भारत</string>
    <string name="privacy_core_commitment">मूल प्रतिबद्धता</string>
    <string name="privacy_core_commitment_desc">हम सर्वर पर कोई व्यक्तिगत डेटा एकत्र नहीं करते हैं। आपका उपनाम और प्राथमिकताएं Android Jetpack DataStore और Room के माध्यम से केवल आपके डिवाइस पर सहेजी जाती हैं। कोई विज्ञापन ट्रैकिंग नहीं, कोई टेलीमेट्री नहीं। समाचार सार्वजनिक RSS फ़ीड से HTTPS पर प्राप्त किए जाते हैं।</string>
    <string name="privacy_sec_no_data_title">कोई व्यक्तिगत डेटा एकत्र नहीं</string>
    <string name="privacy_sec_no_data_p1">तरास एक ओपन-सोर्स, गैर-व्यावसायिक F1 साथी ऐप है। हम पूर्ण पारदर्शिता और अधिकतम गोपनीयता में विश्वास करते हैं:</string>
    <string name="privacy_sec_no_data_item1">कोई नाम, ईमेल, फ़ोन नंबर, संपर्क या खाता नहीं</string>
    <string name="privacy_sec_no_data_item2">कोई सटीक या अनुमानित GPS स्थान ट्रैकिंग नहीं</string>
    <string name="privacy_sec_no_data_item3">कोई विज्ञापन आईडी (GAID), डिवाइस आईडी या IP लॉग नहीं</string>
    <string name="privacy_sec_no_data_item4">कोई व्यावसायिक विज्ञापन SDK, मार्केटिंग ट्रैकर या टेलीमेट्री नहीं</string>
    <string name="privacy_sec_dpdpa_title">डिजिटल व्यक्तिगत डेटा संरक्षण अधिनियम, 2023 (भारत)</string>
    <string name="privacy_sec_dpdpa_desc">भारत के डिजिटल व्यक्तिगत डेटा संरक्षण अधिनियम, 2023 (DPDPA 2023) के तहत, यश अजागिया डेटा फिड्युशरी हैं। तरास धारा 6 के तहत उद्देश्य सीमा और न्यूनतम डेटा सिद्धांत का कड़ाई से पालन करता है। सभी प्रोसेसिंग केवल ऑन-डिवाइस होती है।</string>
    <string name="privacy_sec_principal_rights_title">डेटा प्रिंसिपल अधिकार (धारा 11–14 DPDPA)</string>
    <string name="privacy_right_access">पहुंच का अधिकार (धारा 11): ऐप सेटिंग्स में अपनी प्राथमिकताओं की समीक्षा करें।</string>
    <string name="privacy_right_correction">संशोधन का अधिकार (धारा 12): किसी भी समय अपना उपनाम या पसंदीदा बदलें।</string>
    <string name="privacy_right_erasure">मिटाने का अधिकार (धारा 12): Android सेटिंग्स में ऐप डेटा साफ़ करके या ऐप हटाकर तुरंत सारा डेटा मिटाएं।</string>
    <string name="privacy_right_grievance">शिकायत निवारण का अधिकार (धारा 13): सहायता के लिए हमारे नामित शिकायत अधिकारी से संपर्क करें।</string>
    <string name="privacy_sec_storage_title">पूरी तरह से ऑन-डिवाइस स्टोरेज</string>
    <string name="privacy_sec_storage_desc">आपका उपनाम, पसंदीदा ड्राइवर, पसंदीदा टीम, TCG कार्ड संग्रह और थीम Android Jetpack DataStore और Room SQLite के माध्यम से विशेष रूप से आपके डिवाइस पर संग्रहीत हैं।</string>
    <string name="privacy_sec_network_title">सार्वजनिक फ़ीड और एन्क्रिप्शन</string>
    <string name="privacy_sec_network_desc">रेस शेड्यूल और स्टैंडिंग गिटहब से प्राप्त होते हैं। समाचार लेख सार्वजनिक RSS फ़ीड से सीधे आपके डिवाइस पर पार्स किए जाते हैं। सभी कनेक्शन सुरक्षित HTTPS का उपयोग करते हैं।</string>
    <string name="privacy_sec_notifications_title">डिवाइस अनुमतियाँ</string>
    <string name="privacy_sec_notifications_desc">अधिसूचना अनुमति (POST_NOTIFICATIONS) का उपयोग केवल स्थानीय WorkManager रेस काउंटडाउन अनुस्मारक देने के लिए किया जाता है। कोई दूरस्थ पुश टोकन एकत्र नहीं किया जाता है।</string>
    <string name="privacy_sec_children_title">बच्चों की गोपनीयता (धारा 9 DPDPA 2023)</string>
    <string name="privacy_sec_children_desc">तरास बच्चों के पहचान योग्य डेटा को संसाधित नहीं करता है, न ही व्यवहार निगरानी या लक्षित विज्ञापन करता है। यह ऐप सभी उम्र के मोटरस्पोर्ट प्रशंसकों के लिए पूरी तरह सुरक्षित है।</string>
    <string name="privacy_sec_grievance_title">शिकायत अधिकारी (IT नियम 2021 और DPDPA 2023)</string>
    <string name="privacy_sec_grievance_desc">सूचना प्रौद्योगिकी नियम, 2021 के नियम 3(2) और DPDPA 2023 की धारा 13 के अनुसार, शिकायतों की पावती 48 घंटों में दी जाती है और 15-30 दिनों में समाधान किया जाता है।</string>
    <string name="grievance_officer_name">शिकायत अधिकारी: यश अजागिया (Yash Ajagiya)</string>
    <string name="grievance_officer_email">ईमेल: ajagiyayash@gmail.com</string>
    <string name="grievance_officer_location">अधिकार क्षेत्र: गुजरात, भारत</string>
    <string name="privacy_sec_opensource_title">ओपन सोर्स पारदर्शिता</string>
    <string name="privacy_sec_opensource_desc">तरास अपाचे 2.0 लाइसेंस के तहत पूरी तरह से ओपन-सोर्स है। कोई भी गिटहब पर कोड की समीक्षा कर सकता है।</string>
    <string name="privacy_btn_view_online">ऑनलाइन देखें</string>
    <string name="privacy_btn_got_it">समझ गया</string>

    <!-- In-App Terms of Service (Indian Law Compliant) -->
    <string name="terms_title">सेवा की शर्तें</string>
    <string name="terms_badge_it_act">भारत के कानूनों द्वारा शासित</string>
    <string name="terms_sec_agreement_title">1. शर्तों की स्वीकृति</string>
    <string name="terms_sec_agreement_desc">तरास को डाउनलोड, इंस्टॉल या उपयोग करके, आप भारतीय अनुबंध अधिनियम, 1872 और सूचना प्रौद्योगिकी अधिनियम, 2000 द्वारा शासित कानूनी रूप से बाध्यकारी समझौते में प्रवेश करते हैं। यदि आप सहमत नहीं हैं, तो कृपया ऐप को अनइंस्टॉल करें।</string>
    <string name="terms_sec_license_title">2. गैर-व्यावसायिक और ओपन सोर्स लाइसेंस</string>
    <string name="terms_sec_license_desc">तरास अपाचे लाइसेंस संस्करण 2.0 के तहत वितरित एक निःशुल्क, गैर-व्यावसायिक फॉर्मूला 1 साथी ऐप है। स्रोत कोड गिटहब पर पारदर्शी रूप से उपलब्ध है।</string>
    <string name="terms_sec_disclaimer_title">3. अनौपचारिक साथी और ट्रेडमार्क उचित उपयोग</string>
    <string name="terms_sec_disclaimer_desc">तरास एक स्वतंत्र प्रशंसक एप्लिकेशन है। यह फॉर्मूला वन लाइसेंसिंग B.V., FOM, FIA, या किसी भी F1 टीम या ड्राइवर से संबद्ध, प्रायोजित या समर्थित नहीं है। सभी ट्रेडमार्क और नाम संबंधित स्वामियों की संपत्ति हैं और भारतीय ट्रेड मार्क्स अधिनियम, 1999 के तहत केवल पहचान और उचित उपयोग (Nominative Fair Use) के लिए उपयोग किए जाते हैं।</string>
    <string name="terms_sec_intermediary_title">4. मध्यस्थ स्थिति और RSS समाचार सामग्री</string>
    <string name="terms_sec_intermediary_desc">सूचना प्रौद्योगिकी अधिनियम, 2000 की धारा 2(1)(w) के तहत, तरास सार्वजनिक RSS फ़ीड के लिए एक मध्यस्थ/एग्रीगेटर के रूप में कार्य करता है। सभी समाचार अधिकार संबंधित प्रकाशकों के हैं।</string>
    <string name="terms_sec_tcg_title">5. F1 GridTCG और आभासी डिजिटल कार्ड</string>
    <string name="terms_sec_tcg_desc">F1 GridTCG मॉड्यूल में कार्ड पूरी तरह से आभासी, निःशुल्क संग्रहणीय वस्तुएं हैं। इनका कोई वास्तविक मौद्रिक मूल्य नहीं है और यह सार्वजनिक जुआ अधिनियम, 1867 के तहत जुआ या सट्टेबाजी नहीं हैं।</string>
    <string name="terms_sec_conduct_title">6. निषिद्ध गतिविधियाँ</string>
    <string name="terms_sec_conduct_desc">आप सूचना प्रौद्योगिकी अधिनियम, 2000 की धारा 66 का उल्लंघन करते हुए ऐप के डेटा स्रोतों को बाधित न करने या दुर्भावनापूर्ण हमलों का प्रयास न करने के लिए सहमत हैं।</string>
    <string name="terms_sec_warranty_title">7. वारंटी और देयता का अस्वीकरण</string>
    <string name="terms_sec_warranty_desc">यह एप्लिकेशन किसी भी प्रकार की वारंटी के बिना \"जैसा है\" (AS IS) प्रदान किया जाता है। लागू भारतीय कानून के तहत, डेवलपर किसी भी अप्रत्यक्ष या परिणामी नुकसान के लिए उत्तरदायी नहीं होगा।</string>
    <string name="terms_sec_jurisdiction_title">8. शासी कानून और अधिकार क्षेत्र</string>
    <string name="terms_sec_jurisdiction_desc">ये शर्तें भारत गणराज्य के कानूनों द्वारा शासित होंगी। गुजरात, भारत की अदालतों के पास अनन्य अधिकार क्षेत्र होगा।</string>

    <!-- In-App About Us -->
    <string name="about_title">तरास के बारे में</string>
    <string name="about_tagline">एक उच्च प्रदर्शन, ट्रैकर-मुक्त फॉर्मूला 1 साथी</string>
    <string name="about_sec_story_title">तरास (तरस्) का अर्थ</string>
    <string name="about_sec_story_desc">\"तरास\" (तरस्) एक कालातीत संस्कृत शब्द है जिसका अर्थ है \"गति,\" \"वेग,\" \"ऊर्जा,\" और \"शक्ति।\" यह फॉर्मूला 1 मोटरस्पोर्ट की भावना का प्रतीक है—तीव्र, शक्तिशाली और सटीक।</string>
    <string name="about_sec_developer_title">डेवलपर और दृष्टिकोण</string>
    <string name="about_sec_developer_desc">भारत के एक स्वतंत्र एंड्रॉइड इंजीनियर और F1 प्रशंसक यश अजागिया द्वारा जुनून के साथ निर्मित। प्रशंसकों को बिना विज्ञापनों और बिना ट्रैकिंग के एक सहज अनुभव प्रदान करने के लिए बनाया गया।</string>
    <string name="about_sec_pillars_title">मूल डिज़ाइन सिद्धांत</string>
    <string name="about_pillar1_title">100% निजी · शून्य ट्रैकर</string>
    <string name="about_pillar1_desc">कोई खाता नहीं, कोई विज्ञापन नहीं, कोई एनालिटिक्स नहीं। डेटा केवल आपके फ़ोन पर रहता है।</string>
    <string name="about_pillar2_title">भारतीय और वैश्विक कानून अनुपालक</string>
    <string name="about_pillar2_desc">भारत के डिजिटल व्यक्तिगत डेटा संरक्षण अधिनियम (DPDPA 2023) और IT अधिनियम 2000 के अनुरूप।</string>
    <string name="about_pillar3_title">आधुनिक एंड्रॉइड और ओपन सोर्स</string>
    <string name="about_pillar3_desc">Jetpack Compose, Material 3, Room और Navigation 3 के साथ अपाचे 2.0 लाइसेंस के तहत निर्मित।</string>
    <string name="about_sec_tech_title">इंजीनियरिंग और तकनीक</string>
    <string name="about_sec_tech_desc">Jetpack Compose · Material 3 · Room SQLite · DataStore · Ksoup XML · Glance Widgets · WorkManager</string>
    <string name="about_sec_compliance_title">भारतीय कानूनी प्रकटीकरण</string>
